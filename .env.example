# 지자기 지구본 LLM 질의판(geomag_globe_llm.html) 설정 예시.
# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 커밋되지 않습니다)
#
#   cp .env.example .env

# ── 백엔드 선택 ────────────────────────────────────────────────────────────
#   auto      : LM Studio 먼저 시도 → 실패하면 OpenAI(키 있을 때) → 서버계산 폴백 (기본)
#   lmstudio  : LM Studio 만 사용
#   openai    : OpenAI API 만 사용 (아래 키 필요)
GLOBE_LLM_BACKEND=auto

# ── OpenAI API (선택) ──────────────────────────────────────────────────────
# 키를 넣으면 LLM 연결이 됩니다. 키는 이 서버(.env)에만 있고 브라우저엔 노출 안 됩니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 호환 엔드포인트(예: Azure/프록시)면 변경. 기본은 공식 OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 로컬 LM Studio (선택) ──────────────────────────────────────────────────
LM_STUDIO_URL=http://localhost:1234/v1
# 빈 값이면 LM Studio 에 로드된 모델 자동 사용
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT=120
