/output/

# ── 프레젠테이션 ──────────────────────────────────────────────
pptx/

# ── 로컬 전용 실행 스크립트 (PC별 경로 포함, 커밋 안 함) ──────
run_viewer.bat

# ── LLM API 키 등 비밀 설정 (.env.example 만 커밋) ────────────
.env

# ── 대용량 데이터 원본 ────────────────────────────────────────
data/zone_cache/
# CYG 1분 자료 캐시 (HAPI 에서 재다운로드 가능)
data/cyg/
# KASA 관측소 자료 캐시 (kasa_geomag.py 로 재다운로드 가능, README_coverage.md 는 커밋)
data/kasa/*.csv
data/*.zip
data/*.hwp
data/*.pdf
data/*.xls
data/*.xlsx
data/*.html
data/*.dat
data/*.csv
# 측점 이력표는 큐레이션한 메타데이터라 커밋한다
!data/station_history.csv
# 관측망 원장 30점은 좌표 정본이라 반드시 커밋한다 (existing_network.py 가 읽는다)
!data/geomag_network_30.csv
data/*.json
# 그 원장의 출처·해시 기록 (사이드카)
!data/geomag_network_30.meta.json
data/수치지질도_25만축척_전국/
