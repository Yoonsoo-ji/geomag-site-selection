			<latitude>34.93569056728958</latitude>
			<altitude>253.1216763195025</altitude>
			<heading>0.8448471843281417</heading>
			<tilt>0.108154768960706</tilt>
			<gx:fovy>35</gx:fovy>
			<range>593.3041749584663</range>
			<altitudeMode>absolute</altitudeMode>
		</LookAt>
		<styleUrl>#__managed_style_0B94C8BC9A4003284EF3</styleUrl>
		<Point>
			<coordinates>128.6398127564191,34.93608042672246,232.7077193062078</coordinates>
		</Point>
	</Placemark>
